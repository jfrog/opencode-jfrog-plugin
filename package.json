{
  "name": "@jfrog/opencode-jfrog-plugin",
  "version": "1.0.0",
  "description": "JFrog Plugin for seamless integration to Opencode",
  "author": {
    "name": "JFrog",
    "email": "carmith@jfrog.com"
  },
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "jfrog",
    "artifactory",
    "opencode",
    "plugin"
